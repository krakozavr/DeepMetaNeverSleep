{
  "manifest_version": 3,
  "name": "DeepMeta Never Sleep",
  "version": "1.9.0",
  "description": "Prevents your computer from sleeping during active DeepMeta file uploads",
  "key": "",
  "permissions": [
    "tabs",
    "power",
    "webRequest",
    "alarms",
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "283084521733-kdr21rmqd9dof6trl9knltukpcc1tha4.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/tasks"]
  },
  "host_permissions": [
    "https://deepmeta.creativ.zone/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://deepmeta.creativ.zone/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://deepmeta.creativ.zone/*"],
      "js": ["scroll-restore.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://deepmeta.creativ.zone/contribute/esp/briefs*"],
      "js": ["briefs-calendar.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon-16-waiting.png",
    "48": "icons/icon-48-waiting.png",
    "128": "icons/icon128-waiting.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16-waiting.png",
      "48": "icons/icon-48-waiting.png",
      "128": "icons/icon128-waiting.png"
    }
  }
}
