{
  "manifest_version": 3,
  "name": "DeepMeta Never Sleep",
  "version": "1.1.1",
  "description": "Prevents your computer from sleeping during active DeepMeta file uploads",
  "permissions": [
    "tabs",
    "power",
    "webRequest"
  ],
  "host_permissions": [
    "https://deepmeta.creativ.zone/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://deepmeta.creativ.zone/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "deepmeta-never-sleep@creativ.zone",
      "strict_min_version": "109.0"
    }
  }
}
